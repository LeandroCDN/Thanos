# Trading mode: dry_run (simulated) | live (real orders)
TRADING_MODE=dry_run

# Polymarket credentials
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Kalshi credentials
KALSHI_API_KEY=
KALSHI_SECRET=

# AI pair review (optional, enables settlement-condition analysis)
# Easiest free path: run Ollama on :11434 or LM Studio on :1234. The app auto-detects local models first.
# Leave PAIR_REVIEW_PROVIDER blank for auto mode. Set it only when you want to force a provider.
# Supported forced providers: gemini, openai, openai_compatible, openrouter, groq, deepseek, ollama, disabled
PAIR_REVIEW_PROVIDER=
PAIR_REVIEW_FREE_LOCAL=auto
PAIR_REVIEW_LOCAL_FIRST=true
PAIR_REVIEW_LOCAL_MODEL=
PAIR_REVIEW_LOCAL_BASE_URLS=http://localhost:11434/v1,http://localhost:1234/v1
PAIR_REVIEW_MODEL=
PAIR_REVIEW_API_KEY=
PAIR_REVIEW_BASE_URL=
PAIR_REVIEW_API_STYLE=
PAIR_REVIEW_RESPONSE_FORMAT=json_object
PAIR_REVIEW_CONCURRENCY=4
PAIR_REVIEW_TIMEOUT_SECONDS=30
PAIR_REVIEW_MAX_OUTPUT_TOKENS=350
GEMINI_API_KEY=
GEMINI_PAIR_REVIEW_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_PAIR_REVIEW_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_PAIR_REVIEW_MODEL=
GROQ_API_KEY=
GROQ_PAIR_REVIEW_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_PAIR_REVIEW_MODEL=
PAIR_REVIEW_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_PAIR_REVIEW_MODEL=

# Bot settings
BOT_CHECK_INTERVAL_MINUTES=60
BOT_TAKE_PROFIT_PCT=10
BOT_STOP_LOSS_PCT=-15
BOT_MIN_DAYS_TO_CLOSE=3

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
